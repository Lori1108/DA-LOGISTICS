generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENTAS
  ENTREGAS
  PREVENTA
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role
  name     String
}

model StoreData {
  id        Int      @id @default(autoincrement())
  products  Json     @default("[]")
  orders    Json     @default("[]")
  clients   Json     @default("[]")
  updatedAt DateTime @updatedAt
}
