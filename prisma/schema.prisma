generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StoreData {
  id        Int      @id @default(1)
  products  Json     @default("[]")
  orders    Json     @default("[]")
  clients   Json     @default("[]")
  updatedAt DateTime @updatedAt
}
